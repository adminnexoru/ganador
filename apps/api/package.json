    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@ganador/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg-boss": "~12.34.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
