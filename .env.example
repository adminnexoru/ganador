# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- API ---
PORT=3000
DATABASE_URL=postgres://ganador:ganador@localhost:5432/ganador
POSTGRES_USER=ganador
POSTGRES_PASSWORD=ganador
JWT_SECRET=cambia-esto-por-un-secreto-largo
INGEST_SECRET=cambia-esto-tambien
PUBLIC_WEB_URL=https://ganador.nexoru.ai
PRIVACY_NOTICE_VERSION=v1

# --- Traccar (ingesta) ---
TRACCAR_URL=http://localhost:8082
TRACCAR_USER=servicio@ganador.local
TRACCAR_PASSWORD=cambia-esto
# Solo desarrollo: aceptar dispositivos desconocidos y publicar OsmAnd en la LAN.
TRACCAR_REGISTER_UNKNOWN=true
TRACCAR_OSMAND_BIND=0.0.0.0
# Servidor: http://api:3000
TRACCAR_FORWARD_BASE=http://host.docker.internal:3000

# --- Mensajería (fake escribe los mensajes en el registro) ---
MESSAGING_PROVIDER=fake
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_OTP=codigo_acceso
WHATSAPP_TEMPLATE_ZONE_EXIT=alerta_salida_zona
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# --- Fotos (almacenamiento compatible con S3; vacío = disco local en desarrollo) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
LOCAL_STORAGE_DIR=./.storage

# --- Respaldos (servidor) ---
BACKUP_PASSPHRASE=cambia-esto-y-guardalo-fuera-del-servidor
ACME_EMAIL=admin@nexoru.ai

# --- App móvil ---
# En desarrollo con Expo Go usa la IP de tu máquina en la LAN.
EXPO_PUBLIC_API_URL=https://api.ganador.nexoru.ai
GOOGLE_MAPS_ANDROID_KEY=
